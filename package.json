{
  "name": "personal-input-analytics-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "demo": "tsx apps/demo/src/index.ts",
    "demo:empty": "tsx apps/demo/src/index.ts --scenario empty-history --preset today",
    "test:web": "vitest run apps/web-dashboard/src/__tests__",
    "web": "vite --config apps/web-dashboard/vite.config.ts",
    "web:build": "vite build --config apps/web-dashboard/vite.config.ts",
    "release:check": "npm run test && npm run build && npm run demo -- --scenario normal-day --preset last-7-days >/dev/null",
    "test": "vitest run",
    "test:agent-f": "vitest run tests/agentF.regression.test.ts tests/agentF.snapshots.test.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.0.0",
    "vite": "^7.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
